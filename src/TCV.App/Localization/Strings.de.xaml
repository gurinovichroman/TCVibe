    <sys:String x:Key="Viewer_GoToHint">Ctrl+G. Ein Byte-Offset: 4096, 0x1000, 50% oder 12MB</sys:String>
    <sys:String x:Key="Viewer_Go">Los</sys:String>
    <sys:String x:Key="Viewer_BadOffset">"{0}" ist kein Offset — Bytes, 0x…, einen Prozentwert oder eine Größe verwenden</sys:String>
    <sys:String x:Key="Viewer_Reading">Wird gelesen…</sys:String>
    <sys:String x:Key="Viewer_ReadingBytes">Wird gelesen… {0} von {1}</sys:String>
    <sys:String x:Key="Viewer_ReadFailed">Lesen nicht möglich: {0}</sys:String>
    <sys:String x:Key="Viewer_Opening">Datei wird geöffnet…</sys:String>
    <sys:String x:Key="Viewer_OpenFailed">Die Datei kann nicht angezeigt werden</sys:String>
    <sys:String x:Key="Viewer_FirstFile">Dies ist die erste Datei des Panels</sys:String>
    <sys:String x:Key="Viewer_LastFile">Dies ist die letzte Datei des Panels</sys:String>
