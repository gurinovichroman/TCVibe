    <sys:String x:Key="Viewer_Go">Aller</sys:String>
    <sys:String x:Key="Viewer_BadOffset">"{0}" n'est pas un décalage — utilisez des octets, 0x…, un pourcentage ou une taille</sys:String>
    <sys:String x:Key="Viewer_Reading">Lecture…</sys:String>
    <sys:String x:Key="Viewer_ReadingBytes">Lecture… {0} sur {1}</sys:String>
    <sys:String x:Key="Viewer_ReadFailed">Lecture impossible : {0}</sys:String>
