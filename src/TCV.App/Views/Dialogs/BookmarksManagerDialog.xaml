<local:TcvDialog x:Class="TCV.App.Views.Dialogs.BookmarksManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{DynamicResource Bookmarks_Title}" Height="480" Width="720" MinHeight="360" MinWidth="560">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left: list + action buttons -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutomationProperties.Name="{DynamicResource Bookmarks_Title}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Bookmarks_ColName}" Width="140"
                                            DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="{DynamicResource Bookmarks_ColGroup}" Width="90"
                                            DisplayMemberBinding="{Binding DisplayGroup}"/>
                            <GridViewColumn Header="{DynamicResource Bookmarks_ColPath}" Width="220"
                                            DisplayMemberBinding="{Binding DisplayPath}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <WrapPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
                    <Button Content="{DynamicResource Bookmarks_Add}"    Command="{Binding AddCommand}"    Margin="0,0,4,4" MinWidth="75"/>
                    <Button Content="{DynamicResource Bookmarks_Remove}" Command="{Binding RemoveCommand}" Margin="0,0,4,4" MinWidth="75"/>
                    <Button Content="{DynamicResource Bookmarks_MoveUp}" Command="{Binding MoveUpCommand}" Margin="0,0,4,4" MinWidth="75"
                            AutomationProperties.Name="{DynamicResource Bookmarks_MoveUpName}"/>
                    <Button Content="{DynamicResource Bookmarks_MoveDown}" Command="{Binding MoveDownCommand}" Margin="0,0,4,4" MinWidth="75"
                            AutomationProperties.Name="{DynamicResource Bookmarks_MoveDownName}"/>
                    <Button Content="{DynamicResource Bookmarks_Import}" Command="{Binding ImportBookmarksCommand}" Margin="0,0,4,4" MinWidth="75"/>
                    <Button Content="{DynamicResource Bookmarks_Export}" Command="{Binding ExportBookmarksCommand}" Margin="0,0,0,4" MinWidth="75"/>
                </WrapPanel>
            </Grid>

            <!-- Right: edit form -->
            <GroupBox Grid.Column="2" Header="{DynamicResource Bookmarks_Properties}"
                      IsEnabled="{Binding HasSelection}">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Bookmarks_LabelName}"
                           Target="{Binding ElementName=NameBox}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Bookmarks_LabelPath}"
                           Target="{Binding ElementName=PathBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PathBox"
                             Text="{Binding EditPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Bookmarks_PathHint}"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource Bookmarks_LabelGroup}"
                           Target="{Binding ElementName=GroupNameBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="GroupNameBox"
                             Text="{Binding EditGroup, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Bookmarks_GroupHint}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasValidationMessage, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Guest window notice (TRAP-22), then the buttons -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WarningBrush}"
                       Text="{DynamicResource Bookmarks_GuestNote}"
                       Visibility="{Binding IsGuestWindow, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource OK}"     Command="{Binding SaveCommand}"   Margin="0,0,8,0" MinWidth="80" IsDefault="True"/>
                <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" MinWidth="80" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:TcvDialog>
