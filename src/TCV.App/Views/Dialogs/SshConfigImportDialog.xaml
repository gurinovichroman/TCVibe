<local:TcvDialog x:Class="TCV.App.Views.Dialogs.SshConfigImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:vm="clr-namespace:TCV.App.ViewModels.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{DynamicResource SshImport_Title}"
        Width="640" Height="480"
        MinWidth="460" MinHeight="320"
        ResizeMode="CanResizeWithGrip">

    <!-- What an import from ~/.ssh/config would add (6.82): every concrete host, the ones already saved
         unticked, and what the file said that could not be used. Nothing is saved until Import. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Intro}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundDimBrush}" />

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,6"
                BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}"
                Visibility="{Binding HasWarnings, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
        </Border>

        <ListBox Grid.Row="3" x:Name="HostList" ItemsSource="{Binding Rows}"
                 AutomationProperties.Name="{DynamicResource SshImport_Title}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SshImportRowViewModel}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,8,0"
                                  AutomationProperties.Name="{Binding Title}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Address}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Address}" Foreground="{DynamicResource ForegroundDimBrush}" />
                            <TextBlock Text="{Binding KeyFile}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding KeyFile}" Foreground="{DynamicResource ForegroundDimBrush}"
                                       Visibility="{Binding KeyFile, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding Notes}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       Visibility="{Binding Notes, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding DuplicateText}" FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding IsDuplicate, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="5" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundDimBrush}" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource Cancel}" MinWidth="90"
                    Command="{Binding CancelCommand}" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource SshImport_Import}" MinWidth="110" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" IsDefault="True" />
        </DockPanel>
    </Grid>
</local:TcvDialog>
