<local:TcvDialog x:Class="TCV.App.Views.Dialogs.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{Binding Title}"
        Width="480" Height="240"
        ResizeMode="NoResize"
        AutomationProperties.Name="{Binding Title}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current file -->
        <TextBlock Grid.Row="0"
                   Text="{Binding CurrentFile}"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" />

        <!-- Progress bar -->
        <ProgressBar Grid.Row="2"
                     Value="{Binding Percentage}"
                     Maximum="100" Height="18"
                     AutomationProperties.Name="{Binding Title}"
                     Foreground="{DynamicResource AccentBrush}" />

        <!-- Percentage + bytes -->
        <Grid Grid.Row="4">
            <TextBlock Text="{Binding Percentage, StringFormat={}{0:F0}%}"
                       HorizontalAlignment="Left" />
            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"
                       Text="{Binding BytesText}" />
        </Grid>

        <!-- Speed + elapsed -->
        <Grid Grid.Row="6">
            <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Left"
                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" />
            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11">
                <Run Text="{DynamicResource Progress_Elapsed}" />
                <Run Text=" " />
                <Run Text="{Binding ElapsedText, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!-- Remaining time -->
        <Grid Grid.Row="8">
            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RemainingText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{DynamicResource Progress_Remaining}" />
                <Run Text=" " />
                <Run Text="{Binding RemainingText, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0"
                    Command="{Binding PauseResumeCommand}"
                    Visibility="{Binding ShowPause, Converter={StaticResource BoolToVis}}">
                <Button.Content>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource Dlg_Progress_Pause}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Dlg_Progress_Resume}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button Content="{DynamicResource Dlg_Progress_Cancel}" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}" />
            <!-- Only one of Cancel/Close is ever visible, so Esc and Enter reach whichever is shown. -->
            <Button Content="{DynamicResource Close}" Width="90"
                    Command="{Binding CloseCommand}"
                    IsDefault="True" IsCancel="True"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
