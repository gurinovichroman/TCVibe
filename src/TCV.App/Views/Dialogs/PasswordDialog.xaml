<local:TcvDialog x:Class="TCV.App.Views.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        Title="{DynamicResource Password_Title}"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   TextWrapping="Wrap" />

        <Label Grid.Row="2" Content="{DynamicResource Password_Label}" Target="{Binding ElementName=PwdBox}" Padding="0" />

        <PasswordBox Grid.Row="4" x:Name="PwdBox" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource OK}" Width="80" Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True" />
            <Button Content="{DynamicResource Cancel}" Width="80"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
