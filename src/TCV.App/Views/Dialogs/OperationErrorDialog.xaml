<local:TcvDialog x:Class="TCV.App.Views.Dialogs.OperationErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        Title="{DynamicResource OpError_Title}"
        Width="520" MinHeight="160" SizeToContent="Height"
        ResizeMode="NoResize"
        AutomationProperties.Name="{DynamicResource OpError_Title}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource OpError_Headline}" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Grid.Row="2" Text="{Binding Path}" TextWrapping="Wrap" FontSize="11"
                   ToolTip="{Binding Path}"
                   Foreground="{DynamicResource ForegroundDimBrush}" />
        <TextBlock Grid.Row="4" Text="{Binding Message}" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" />

        <WrapPanel Grid.Row="6" HorizontalAlignment="Right">
            <Button Content="{DynamicResource OpError_Retry}" MinWidth="80" Margin="0,0,6,0" Padding="8,3"
                    Command="{Binding RetryCommand}" IsDefault="True" />
            <Button Content="{DynamicResource OpError_Skip}" MinWidth="80" Margin="0,0,6,0" Padding="8,3"
                    Command="{Binding SkipCommand}" />
            <Button Content="{DynamicResource OpError_SkipAll}" MinWidth="90" Margin="0,0,6,0" Padding="8,3"
                    ToolTip="{DynamicResource OpError_SkipAllTip}"
                    Command="{Binding SkipAllCommand}" />
            <Button Content="{DynamicResource OpError_Abort}" MinWidth="80" Padding="8,3"
                    Command="{Binding AbortCommand}" IsCancel="True" />
        </WrapPanel>
    </Grid>
</local:TcvDialog>
