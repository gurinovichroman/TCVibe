<Window x:Class="TCV.App.Views.Dialogs.FileViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{Binding Title}"
        Width="920" Height="660"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Navigation through a file bigger than the window: only when there is somewhere to go. -->
            <RowDefinition Height="Auto" />
            <!-- Summary strip (6.14): collapsed until one is asked for. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,4" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_Code}" Padding="10,3" Margin="0,0,4,0"
                        Command="{Binding ShowCodeCommand}"
                        Visibility="{Binding CanShowCode, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_Markdown}" Padding="10,3" Margin="0,0,4,0"
                        Command="{Binding ShowMarkdownCommand}"
                        Visibility="{Binding IsMarkdownFile, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_Text}"  Padding="10,3" Margin="0,0,4,0"
                        Command="{Binding ShowTextCommand}" />
                <Button DockPanel.Dock="Left" Content="HEX"    Padding="10,3" Margin="0,0,4,0"
                        Command="{Binding ShowHexCommand}" />
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_Image}" Padding="10,3" Margin="0,0,12,0"
                        Command="{Binding ShowImageCommand}" />

                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Viewer_Encoding}" VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           Visibility="{Binding IsHexMode, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}" />
                <ComboBox DockPanel.Dock="Left" Width="190" Margin="0,0,12,0"
                          AutomationProperties.Name="{DynamicResource Viewer_Encoding}"
                          ItemsSource="{Binding Encodings}"
                          SelectedItem="{Binding SelectedEncoding}"
                          DisplayMemberPath="Name"
                          Visibility="{Binding IsHexMode, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}" />
                <CheckBox DockPanel.Dock="Left" Content="{DynamicResource Viewer_Wrap}" VerticalAlignment="Center"
                          IsChecked="{Binding WordWrap}"
                          Visibility="{Binding IsHexMode, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}" />

                <!-- Find (right side). Enter / F3 next, Shift+Enter / Shift+F3 previous; focus stays in the box so it cycles. -->
                <Button DockPanel.Dock="Right" Content="▼" Padding="8,3" Margin="2,0,0,0"
                        AutomationProperties.Name="{DynamicResource Viewer_FindNext}"
                        ToolTip="{DynamicResource Viewer_FindNext}"
                        Click="OnFindNext" />
                <Button DockPanel.Dock="Right" Content="▲" Padding="8,3" Margin="4,0,0,0"
                        AutomationProperties.Name="{DynamicResource Viewer_FindPrevious}"
                        ToolTip="{DynamicResource Viewer_FindPrevious}"
                        Click="OnFindPrevious" />
                <TextBox DockPanel.Dock="Right" x:Name="FindBox" Width="180" VerticalAlignment="Center"
                         AutomationProperties.Name="{DynamicResource Viewer_Find}"
                         ToolTip="{DynamicResource Viewer_FindHint}"
                         TextChanged="OnFindTextChanged"
                         KeyDown="OnFindBoxKeyDown" />

                <!-- On explicit request only, and hidden when no model is configured (6.14). -->
                <Button DockPanel.Dock="Right" Content="{DynamicResource Viewer_Summarize}" Padding="10,3" Margin="4,0,8,0"
                        Command="{Binding SummarizeCommand}"
                        IsEnabled="{Binding CanSummarize}"
                        Visibility="{Binding LlmAvailable, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>

        <!-- Moving the window over a file that does not fit: start, tail, blocks, a typed offset. Also
             shown while N/P is slow to open the next file, for its progress and Cancel. -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowsNavigationBar, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="6,3" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_ToStart}" Padding="8,2" Margin="0,0,4,0"
                        Command="{Binding GoToStartCommand}" />
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_PrevBlock}" Padding="8,2" Margin="0,0,4,0"
                        Command="{Binding PageBackCommand}" />
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_NextBlock}" Padding="8,2" Margin="0,0,4,0"
                        Command="{Binding PageForwardCommand}" />
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_ToEnd}" Padding="8,2" Margin="0,0,16,0"
                        Command="{Binding GoToEndCommand}" />

                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Viewer_GoTo}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox DockPanel.Dock="Left" x:Name="OffsetBox" Width="130" VerticalAlignment="Center"
                         AutomationProperties.Name="{DynamicResource Viewer_GoTo}"
                         ToolTip="{DynamicResource Viewer_GoToHint}"
                         Text="{Binding OffsetInput, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnOffsetBoxKeyDown" />
                <Button DockPanel.Dock="Left" Content="{DynamicResource Viewer_Go}" Padding="8,2" Margin="4,0,0,0"
                        Command="{Binding GoToOffsetCommand}" />

                <!-- Shown while a block is being read; the old block stays until the new one arrives -->
                <Button DockPanel.Dock="Right" Content="{DynamicResource Cancel}" Padding="8,2" Margin="8,0,0,0"
                        Command="{Binding CancelLoadCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>

        <!-- The summary sits above the file rather than in a message box, so it can be read next to
             what it describes. -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6" MaxHeight="180"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="22" Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource Close}"
                        ToolTip="{DynamicResource Close}"
                        Command="{Binding ClearSummaryCommand}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="3">
            <TextBox x:Name="TextView"
                     Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVis}}"
                     Text="{Binding TextContent, Mode=OneWay}"
                     AutomationProperties.Name="{DynamicResource Viewer_Text}"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     FontFamily="Consolas" FontSize="13"
                     TextWrapping="{Binding TextWrapping}"
                     Background="{DynamicResource BackgroundBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />

            <TextBox x:Name="HexView"
                     Visibility="{Binding IsHexMode, Converter={StaticResource BoolToVis}}"
                     Text="{Binding HexContent, Mode=OneWay}"
                     AutomationProperties.Name="HEX"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     FontFamily="Consolas" FontSize="13"
                     TextWrapping="NoWrap"
                     Background="{DynamicResource BackgroundBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />

            <!-- Code and markdown share one flow-document surface (6.18); its content is built
                 in code-behind from the pure highlighter/markdown models. -->
            <FlowDocumentScrollViewer x:Name="RichView"
                     Visibility="{Binding IsRichMode, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.Name="{DynamicResource Viewer_Code}"
                     IsSelectionEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource BackgroundBrush}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     BorderThickness="0" />

            <ScrollViewer x:Name="ImageScroller"
                          Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVis}}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Image Source="{Binding ImageSource}" Stretch="None"
                           AutomationProperties.Name="{Binding FileName}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ImageMessage}" TextWrapping="Wrap" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundDimBrush}"
                               Visibility="{Binding HasImageError, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FindStatus}" Margin="8,3"
                           Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                <TextBlock Text="{Binding StatusText}" Margin="8,3"
                           Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
