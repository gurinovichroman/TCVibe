<local:TcvDialog x:Class="TCV.App.Views.Dialogs.SavedOperationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{DynamicResource SavedOp_Title}" Height="500" Width="820"
        MinHeight="420" MinWidth="660"
        FocusManager.FocusedElement="{Binding ElementName=OperationList}">

    <local:TcvDialog.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </local:TcvDialog.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Left: the operations, with what each one does under its name -->
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="8"/>
                <!-- Right: the selected one -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" x:Name="OperationList"
                         AutomationProperties.Name="{DynamicResource SavedOp_Title}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
                    <Button Content="{DynamicResource SavedOp_Add}" Command="{Binding AddCommand}"
                            Margin="0,0,4,0" MinWidth="80"/>
                    <Button Content="{DynamicResource SavedOp_Remove}" Command="{Binding RemoveCommand}"
                            MinWidth="80"/>
                </StackPanel>
            </Grid>

            <!-- Every keystroke goes into the selected copy; OK writes the copies back. -->
            <GroupBox Grid.Column="2" Header="{DynamicResource SavedOp_Properties}"
                      IsEnabled="{Binding HasSelection}">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource SavedOp_Name}"
                           Target="{Binding ElementName=NameBox}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox"
                             AutomationProperties.Name="{DynamicResource SavedOp_Name}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource SavedOp_Kind}"
                           Target="{Binding ElementName=KindBox}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="KindBox" HorizontalAlignment="Left" MinWidth="180"
                              AutomationProperties.Name="{DynamicResource SavedOp_Kind}"
                              ItemsSource="{Binding KindOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Kind"
                              SelectedValue="{Binding EditKind}"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource SavedOp_Mask}"
                           Target="{Binding ElementName=MaskBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="MaskBox"
                             AutomationProperties.Name="{DynamicResource SavedOp_Mask}"
                             IsEnabled="{Binding UsesMask}"
                             Text="{Binding EditSourceMask, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource SavedOp_MaskHint}"
                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>

                    <Label Grid.Row="7" Grid.Column="0" Content="{DynamicResource SavedOp_Target}"
                           Target="{Binding ElementName=TargetBox}"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="TargetBox"
                             AutomationProperties.Name="{DynamicResource SavedOp_Target}"
                             IsEnabled="{Binding UsesTarget}"
                             Text="{Binding EditTarget, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource SavedOp_TargetHint}"
                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>

                    <CheckBox Grid.Row="10" Grid.Column="1" Content="{DynamicResource SavedOp_CreateTarget}"
                              IsEnabled="{Binding UsesCreateTarget}"
                              IsChecked="{Binding EditCreateTarget}"/>
                    <!-- Moving and deleting always ask (INV-11): the box is shown ticked and locked for them -->
                    <CheckBox Grid.Row="12" Grid.Column="1" Content="{DynamicResource SavedOp_ConfirmBox}"
                              IsEnabled="{Binding ConfirmIsOptional}"
                              IsChecked="{Binding EditConfirm}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- The first problem with the list; OK stays blocked until it is fixed -->
        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="{Binding ErrorText}"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <!-- Commands, not Click handlers: a Click that closes the window runs before the command (TRAP-39) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource OK}" Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="80" IsDefault="True"/>
            <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" MinWidth="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</local:TcvDialog>
