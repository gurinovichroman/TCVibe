<local:TcvDialog x:Class="TCV.App.Views.Dialogs.RemoteEditFlushDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{DynamicResource RemoteEdit_FlushTitle}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        AutomationProperties.Name="{DynamicResource RemoteEdit_FlushTitle}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="{DynamicResource RemoteEdit_FlushMessage}" TextWrapping="Wrap" />
        <Grid Margin="0,12,0,0">
            <TextBlock Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"
                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" />
            <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right"
                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" />
        </Grid>
        <ProgressBar Height="18" Margin="0,6,0,0" IsIndeterminate="True"
                     AutomationProperties.Name="{DynamicResource RemoteEdit_FlushTitle}"
                     Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{DynamicResource RemoteEdit_FlushStopHint}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" />
        <!-- No IsCancel: Esc and the cross go through OnClosing, the button through its command (TRAP-77). -->
        <Button Content="{DynamicResource RemoteEdit_FlushStop}" Command="{Binding StopCommand}"
                HorizontalAlignment="Right" MinWidth="90" Padding="10,0" Margin="0,12,0,0" />
    </StackPanel>
</local:TcvDialog>
