<local:TcvDialog x:Class="TCV.App.Views.Dialogs.GitWorktreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{Binding WindowTitle}"
        Width="820" Height="440"
        MinWidth="620" MinHeight="320">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  x:Name="WorktreeList"
                  ItemsSource="{Binding Worktrees}"
                  SelectedItem="{Binding Selected}"
                  AutomationProperties.Name="{DynamicResource Git_WtTitle}"
                  MouseDoubleClick="OnListDoubleClick"
                  KeyDown="OnListKeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource Git_WtCol_Branch}" Width="200"
                                    DisplayMemberBinding="{Binding Branch}" />
                    <GridViewColumn Header="{DynamicResource Git_WtCol_State}" Width="80"
                                    DisplayMemberBinding="{Binding Converter={x:Static conv:WorktreeStateConverter.Instance}}" />
                    <GridViewColumn Header="{DynamicResource Git_WtCol_Sync}" Width="80"
                                    DisplayMemberBinding="{Binding AheadBehindLabel}" />
                    <GridViewColumn Header="{DynamicResource Git_WtCol_Path}" Width="400"
                                    DisplayMemberBinding="{Binding Path}" />
                </GridView>
            </ListView.View>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <!-- The checkout the panel is already in, marked so "switch" has a from. -->
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Missing}" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Margin="0,6,0,0"
                   FontSize="11"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{DynamicResource Git_WtNew}" MinWidth="150" Margin="0,0,8,0"
                        Command="{Binding CreateWorktreeCommand}" />
                <Button Content="{DynamicResource Refresh}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                <!-- Disabled for the main and the current checkout; the tooltip is the only place
                     that can say why, so it has to survive the button being greyed out. -->
                <Button Content="{DynamicResource Git_WtRemove}" MinWidth="110"
                        Command="{Binding RemoveSelectedCommand}"
                        IsEnabled="{Binding CanRemoveSelected}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{DynamicResource Git_WtRemove}"
                        ToolTip="{DynamicResource Git_WtRemoveHint}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Git_WtOpen}" MinWidth="120" Margin="0,0,8,0"
                        Command="{Binding OpenSelectedCommand}"
                        IsEnabled="{Binding CanOpenSelected}"
                        IsDefault="True" />
                <Button Content="{DynamicResource Close}" MinWidth="90"
                        Command="{Binding CancelCommand}"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</local:TcvDialog>
