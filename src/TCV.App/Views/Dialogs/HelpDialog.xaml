<local:TcvDialog x:Class="TCV.App.Views.Dialogs.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        Title="{DynamicResource Help_Title}"
        Width="980" Height="680"
        MinWidth="640" MinHeight="400"
        ShowInTaskbar="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <local:TcvDialog.Resources>
        <!-- A keyboard shortcut drawn as a key cap, as in the palette. Hidden when there is none. -->
        <Style x:Key="GestureChip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Gesture}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A text-only button: article titles in the search results -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="0,2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <CollectionViewSource x:Key="GroupedSections" Source="{Binding Sections}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </local:TcvDialog.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                 x:Name="SearchBox"
                 FontSize="15" Padding="4"
                 Tag="{DynamicResource Help_SearchPlaceholder}"
                 AutomationProperties.Name="{DynamicResource Help_SearchPlaceholder}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

        <!-- Guide articles, then command categories -->
        <ListBox Grid.Row="2" Grid.Column="0"
                 ItemsSource="{Binding Source={StaticResource GroupedSections}}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="4,10,0,4"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundDimBrush}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="8,0,0,0" Opacity="0.5" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="2" Grid.Column="2" x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,0,12,12">
                <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock Text="{DynamicResource Help_NothingFound}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NothingFound}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Search: articles that mention every word -->
                <ItemsControl ItemsSource="{Binding MatchingTopics}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}"
                                    Command="{Binding DataContext.OpenTopicCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock>
                                    <Run Text="{DynamicResource Help_ArticlePrefix}" />
                                    <Run Text="{Binding Title, Mode=OneWay}" TextDecorations="Underline" />
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- An article -->
                <ItemsControl ItemsSource="{Binding Article.Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Block" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Bullet" Text="•" Margin="8,0,8,0" Visibility="Collapsed" />
                                <TextBlock x:Name="Body" Grid.Column="1" Text="{Binding Text}"
                                           TextWrapping="Wrap" LineHeight="20" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                    <Setter TargetName="Body" Property="FontSize" Value="15" />
                                    <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Block" Property="Margin" Value="0,14,0,2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                                    <Setter TargetName="Bullet" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Block" Property="Margin" Value="0,1,0,1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Commands: of the chosen category, or matching the search -->
                <ItemsControl ItemsSource="{Binding VisibleCommands}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}"
                                               FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GestureChip}" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Gesture}" FontFamily="Consolas" FontSize="11" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource DimText}" Text="{Binding Footer}" />
                                    <Button Grid.Row="2" Grid.Column="1" Margin="12,6,0,0" Padding="10,2"
                                            Content="{DynamicResource Help_Run}"
                                            ToolTip="{DynamicResource Help_RunTip}"
                                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:TcvDialog>
