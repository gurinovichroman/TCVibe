<local:TcvDialog x:Class="TCV.App.Views.Dialogs.DropStackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        Title="{DynamicResource Drop_Title}"
        Width="640" Height="440"
        MinWidth="480" MinHeight="300">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Drop_Hint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundDimBrush}" />

        <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Directory}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="{DynamicResource Drop_Remove}" Padding="10,3" Margin="0,0,8,0"
                        Command="{Binding RemoveSelectedCommand}" />
                <Button Content="{DynamicResource Drop_Clear}" Padding="10,3"
                        Command="{Binding ClearStackCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{DynamicResource Drop_CopyHere}" Padding="10,3" Margin="0,0,8,0"
                        Command="{Binding CopyHereCommand}" IsDefault="True" />
                <Button Content="{DynamicResource Drop_MoveHere}" Padding="10,3" Margin="0,0,8,0"
                        Command="{Binding MoveHereCommand}" />
                <Button Content="{DynamicResource Cancel}" Padding="10,3"
                        Command="{Binding CancelCommand}" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</local:TcvDialog>
