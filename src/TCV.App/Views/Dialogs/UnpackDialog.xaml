<local:TcvDialog x:Class="TCV.App.Views.Dialogs.UnpackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{DynamicResource Unpack_Title}"
        Width="480" MinHeight="110" SizeToContent="Height"
        ResizeMode="NoResize">

    <local:TcvDialog.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </local:TcvDialog.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0" Text="{Binding Description}" TextWrapping="Wrap" />

        <!-- Destination path -->
        <TextBox Grid.Row="2" x:Name="DestBox"
                 AutomationProperties.Name="{DynamicResource Unpack_Destination}"
                 Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Windows shell option (ZIP only) -->
        <CheckBox Grid.Row="4"
                  Content="{DynamicResource Unpack_UseShell}"
                  ToolTip="{DynamicResource Unpack_UseShellTip}"
                  IsChecked="{Binding UseWindowsShell}"
                  Visibility="{Binding WindowsShellOptionVisible, Converter={StaticResource BoolToVis}}" />

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource OK}" Width="80" Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True" />
            <Button Content="{DynamicResource Cancel}" Width="80"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
