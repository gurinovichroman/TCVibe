<local:TcvDialog x:Class="TCV.App.Views.Dialogs.AgentLaunchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        xmlns:loc="clr-namespace:TCV.App.Localization"
        Title="{Binding WindowTitle}"
        Width="660" Height="530"
        MinWidth="520" MinHeight="470"
        FocusManager.FocusedElement="{Binding ElementName=TaskBox}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource AgentLaunch_Task}"
                   VerticalAlignment="Top" Margin="0,4,8,0" />
        <!-- Focused on open: the task is the one thing the dialog cannot guess. -->
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TaskBox"
                 Text="{Binding Task, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{DynamicResource AgentLaunch_Task}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource AgentLaunch_Agent}"
                   VerticalAlignment="Center" Margin="0,10,8,0" />
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
            <ComboBox ItemsSource="{Binding Agents}"
                      SelectedItem="{Binding SelectedAgent}"
                      DisplayMemberPath="Name"
                      AutomationProperties.Name="{DynamicResource AgentLaunch_Agent}" />
            <!-- The configured default agent is missing: say which one stands in for it. -->
            <TextBlock Text="{Binding AgentNotice}"
                       Visibility="{Binding HasAgentNotice, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                       Foreground="{DynamicResource WarningBrush}"
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,14,0,0"
                  Content="{DynamicResource AgentLaunch_CreateWorktree}"
                  IsChecked="{Binding CreateWorktree}"
                  IsEnabled="{Binding InsideRepository}"
                  ToolTipService.ShowOnDisabled="True"
                  ToolTip="{DynamicResource AgentLaunch_WorktreeHint}" />

        <!-- Branch and directory only matter when a worktree is being created; hidden rather than
             greyed so the "just run it here" case reads as a short form. -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
              Visibility="{Binding CreateWorktree, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Git_WtBranch}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Git_WtPath}"
                       VerticalAlignment="Center" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                     Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                      Content="{DynamicResource Git_WtCarry}"
                      IsChecked="{Binding CarryFiles}" />

            <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                      Content="{DynamicResource Git_WtRunSetup}"
                      IsChecked="{Binding RunSetupCommand}"
                      IsEnabled="{Binding HasSetupCommand}" />

            <!-- Starts from Settings → «a worktree creates a workspace», as in the new-worktree dialog. -->
            <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"
                      Content="{DynamicResource Git_WtWorkspace}"
                      IsChecked="{Binding CreateWorkspace}" />
        </Grid>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
                   Text="{loc:Live AgentLaunch_Explain}"
                   Opacity="0.7" FontSize="11" TextWrapping="Wrap" />

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding ValidationMessage}"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource AgentLaunch_Start}" MinWidth="130" Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding CanConfirm}"
                    IsDefault="True" />
            <Button Content="{DynamicResource Cancel}" MinWidth="90"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
