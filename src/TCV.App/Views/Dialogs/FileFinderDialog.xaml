<local:TcvDialog x:Class="TCV.App.Views.Dialogs.FileFinderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        Title="{Binding Title}"
        Width="760" Height="520"
        ResizeMode="NoResize"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scope: the subtree Tab narrowed the search to -->
        <TextBlock Grid.Row="0"
                   Text="{Binding ScopeLabel}"
                   Margin="0,0,0,4"
                   Opacity="0.6"
                   FontFamily="Consolas"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasScope}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBox Grid.Row="1"
                 x:Name="SearchBox"
                 FontSize="15" Padding="4"
                 Tag="{Binding Placeholder}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox Grid.Row="3"
                 x:Name="ResultsList"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Results}"
                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 MouseDoubleClick="OnItemDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding RelativeDirectory}"
                                   Margin="10,0,0,0"
                                   Opacity="0.5"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state: a blank list would look the same as "still indexing" -->
        <TextBlock Grid.Row="3"
                   Text="{DynamicResource Finder_NoMatches}"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   Opacity="0.6"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNoMatches}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Index progress + the two keys that are not obvious -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Status}"
                       Opacity="0.6" FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="1"
                       Text="{DynamicResource Finder_Hint}"
                       Opacity="0.5" FontSize="11"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</local:TcvDialog>
