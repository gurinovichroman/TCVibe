<local:TcvDialog x:Class="TCV.App.Views.Dialogs.CommandPaletteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        Title="{Binding Title}"
        Width="640" Height="460"
        ResizeMode="NoResize"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Name="SearchBox"
                 FontSize="15" Padding="4"
                 Tag="{Binding Placeholder}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Status line: used by pickers with a live source (index size, "indexing…") -->
        <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="2,4,0,0" FontSize="11"
                   Foreground="{DynamicResource ForegroundDimBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListBox Grid.Row="3"
                 x:Name="ResultsList"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Results}"
                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 MouseDoubleClick="OnItemDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Category}"
                                       Opacity="0.5" Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                    Padding="6,1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Gesture}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Gesture}"
                                           FontFamily="Consolas" FontSize="11" Opacity="0.85" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</local:TcvDialog>
