<local:TcvDialog x:Class="TCV.App.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{Binding Title}"
        Width="480" MinHeight="140" SizeToContent="Height"
        ResizeMode="NoResize"
        AutomationProperties.Name="{Binding Title}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The warning mark: the confirmed action loses something (a worktree, the log, work in progress) -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x26A0;" FontSize="20" Margin="0,0,12,0"
                   VerticalAlignment="Top"
                   Foreground="{DynamicResource WarningBrush}"
                   Visibility="{Binding IsWarning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

        <!-- Long prompts (a list of files, of windows still using a worktree) scroll instead of
             growing the window past the screen. -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding ConfirmText}" MinWidth="90" Padding="10,3" Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}" />
            <!-- A second way ahead ("Replace" next to "Merge"); absent from a plain yes/no question. -->
            <Button Content="{Binding AlternateText}" MinWidth="90" Padding="10,3" Margin="0,0,8,0"
                    Command="{Binding AlternateCommand}"
                    Visibility="{Binding HasAlternate, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            <!-- Backing out is the default: Enter on a question read too fast must not destroy anything. -->
            <Button Content="{Binding CancelText}" MinWidth="90" Padding="10,3"
                    Command="{Binding CancelCommand}"
                    IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
