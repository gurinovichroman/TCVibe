<local:TcvDialog x:Class="TCV.App.Views.Dialogs.NewFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{DynamicResource NewFolder_Title}"
        Width="380" MinHeight="110" SizeToContent="Height"
        ResizeMode="NoResize"
        AutomationProperties.Name="{DynamicResource NewFolder_Title}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource NewFolder_Name}" />

        <TextBox Grid.Row="2"
                 Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{DynamicResource NewFolder_Name}"
                 x:Name="NameBox" />

        <TextBlock Grid.Row="4" Text="{Binding ValidationMessage}" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource OK}" Width="80" Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True" />
            <Button Content="{DynamicResource Cancel}" Width="80"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
