<local:TcvDialog x:Class="TCV.App.Views.Dialogs.GitDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{Binding Title}"
        Width="900" Height="600"
        MinWidth="500" MinHeight="300">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Git_Branch}" Foreground="{DynamicResource ForegroundDimBrush}"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasDiff, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            <TextBlock Text="{Binding BranchLabel}" Margin="6,0,16,0" FontFamily="Consolas" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Button Content="{DynamicResource Refresh}" MinWidth="90"
                    Command="{Binding LoadCommand}"
                    AutomationProperties.Name="{DynamicResource Refresh}" />
        </StackPanel>

        <!-- One line per row so added / removed / hunk lines take their colour from the same tokens as the F3 viewer. -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource SyntaxCodeBackBrush}">
            <Grid>
                <ListBox ItemsSource="{Binding Lines}"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{DynamicResource Git_DiffTitleShort}"
                         Visibility="{Binding HasDiff, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="2,0" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" xml:space="preserve">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                <Setter Property="Foreground" Value="{DynamicResource SyntaxAddedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                <Setter Property="Foreground" Value="{DynamicResource SyntaxRemovedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                                                <Setter Property="Foreground" Value="{DynamicResource SyntaxHunkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Header">
                                                <Setter Property="Foreground" Value="{DynamicResource SyntaxMetaBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty / error state: the reason there is nothing to show, not a blank pane. -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource ForegroundDimBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                           Visibility="{Binding HasNoDiff, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Git_DiffCopy}" MinWidth="90" Margin="0,0,8,0"
                    Command="{Binding CopyCommand}"
                    IsEnabled="{Binding HasDiff}" />
            <Button Content="{DynamicResource Close}" MinWidth="90" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
