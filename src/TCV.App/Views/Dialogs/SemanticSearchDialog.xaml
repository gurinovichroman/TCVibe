<local:TcvDialog x:Class="TCV.App.Views.Dialogs.SemanticSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        Title="{Binding WindowTitle}"
        Width="920" Height="560"
        MinWidth="640" MinHeight="400">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="QueryBox"
                     AutomationProperties.Name="{DynamicResource Semantic_Search}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" MinHeight="28" />
            <Button Grid.Column="1" Content="{DynamicResource Semantic_Search}" MinWidth="120" Margin="8,0,0,0"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding CanSearch}"
                    IsDefault="True" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
            <TextBlock Text="{DynamicResource Semantic_Root}" Opacity="0.7" />
            <TextBlock Text="{Binding Root}" Margin="6,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            <TextBlock Text="{Binding IndexState}" Opacity="0.7" />
        </StackPanel>

        <ListView Grid.Row="2"
                  AutomationProperties.Name="{DynamicResource Semantic_Title}"
                  ItemsSource="{Binding Hits}"
                  SelectedItem="{Binding Selected}"
                  MouseDoubleClick="OnHitsDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource Semantic_ColScore}" Width="70"
                                    DisplayMemberBinding="{Binding Score, StringFormat=F3}" />
                    <GridViewColumn Header="{DynamicResource Semantic_ColPath}" Width="330"
                                    DisplayMemberBinding="{Binding Path}" />
                    <GridViewColumn Header="{DynamicResource Semantic_ColLines}" Width="90"
                                    DisplayMemberBinding="{Binding StartLine}" />
                    <GridViewColumn Header="{DynamicResource Semantic_ColText}" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- One line: a chunk is ~1.4k characters and wrapping it would make
                                     every row a paragraph. -->
                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxHeight="18" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Margin="0,8,0,0" Opacity="0.8" FontSize="11" TextWrapping="Wrap" />

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{DynamicResource Semantic_Index}" MinWidth="150" Margin="0,0,8,0"
                        Command="{Binding IndexCommand}"
                        IsEnabled="{Binding IsIdle}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="{DynamicResource Semantic_IndexHint}" />
                <Button Content="{DynamicResource Semantic_Stop}" MinWidth="100" Margin="0,0,8,0"
                        Command="{Binding CancelIndexingCommand}"
                        IsEnabled="{Binding IsBusy}" />
                <Button Content="{DynamicResource Semantic_Clear}" MinWidth="120"
                        Command="{Binding ClearIndexCommand}"
                        IsEnabled="{Binding IsIdle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Semantic_ShowAll}" MinWidth="150" Margin="0,0,8,0"
                        Command="{Binding ShowAllInPanelCommand}"
                        IsEnabled="{Binding HasHits}" />
                <Button Content="{DynamicResource Semantic_GoTo}" MinWidth="120" Margin="0,0,8,0"
                        Command="{Binding GoToFileCommand}"
                        IsEnabled="{Binding CanGoToFile}" />
                <Button Content="{DynamicResource Close}" MinWidth="90"
                        Command="{Binding CloseCommand}"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</local:TcvDialog>
