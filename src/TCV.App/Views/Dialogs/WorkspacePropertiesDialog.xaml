<local:TcvDialog x:Class="TCV.App.Views.Dialogs.WorkspacePropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TCV.App.Views.Dialogs"
        xmlns:conv="clr-namespace:TCV.App.Converters"
        xmlns:loc="clr-namespace:TCV.App.Localization"
        Title="{Binding WindowTitle}"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize">

    <local:TcvDialog.Resources>
        <!-- A hint under a field: what it changes and where that shows. -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
        </Style>
        <!-- Hidden while the bound text is empty: validation messages. -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </local:TcvDialog.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WsProps_Name}" Style="{StaticResource FieldLabel}" />
        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBox x:Name="NameBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{DynamicResource WsProps_Name}" />
            <TextBlock Text="{Binding NameError}" Style="{StaticResource ErrorText}" />
        </StackPanel>

        <!-- Icon: one click on a suggestion, or any character typed into the box -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WsProps_Icon}" Style="{StaticResource FieldLabel}" />
        <StackPanel Grid.Row="2" Grid.Column="1">
            <DockPanel LastChildFill="True">
                <TextBox DockPanel.Dock="Left" Width="56" MaxLength="16"
                         FontSize="14" HorizontalContentAlignment="Center" VerticalAlignment="Top"
                         Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{DynamicResource WsProps_Icon}" />
                <ItemsControl ItemsSource="{Binding Icons}" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}"
                                    Content="{Binding}"
                                    FontSize="14"
                                    AutomationProperties.Name="{Binding}"
                                    Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <TextBlock Text="{DynamicResource WsProps_IconHint}" Style="{StaticResource HintText}" />
        </StackPanel>

        <!-- Colour: ready-made swatches, "none", the system picker for anything else, and the hex value -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WsProps_Color}" Style="{StaticResource FieldLabel}" />
        <StackPanel Grid.Row="4" Grid.Column="1">
            <WrapPanel>
                <Button Style="{StaticResource ChipButton}"
                        Content="{DynamicResource WsProps_NoColor}"
                        ToolTip="{DynamicResource WsProps_NoColorTip}"
                        Command="{Binding PickColorCommand}"
                        CommandParameter="" />
                <ItemsControl ItemsSource="{Binding Swatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="28" Height="28" Margin="0,0,4,4" Padding="0"
                                    ToolTip="{Binding Hex}"
                                    AutomationProperties.Name="{Binding Hex}"
                                    Background="Transparent"
                                    Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Hex}">
                                <Grid>
                                    <!-- The ring marks the colour in use -->
                                    <Ellipse Width="24" Height="24" StrokeThickness="2"
                                             Stroke="{DynamicResource ForegroundBrush}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Ellipse Width="18" Height="18"
                                             Fill="{Binding Hex, Converter={x:Static conv:WorkspaceColorToBrushConverter.Instance}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource ChipButton}"
                        Content="{DynamicResource WsProps_OtherColor}"
                        Click="OnPickOtherColor" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Border Width="22" Height="22" CornerRadius="3" Margin="0,0,6,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{Binding NormalizedColor, Converter={x:Static conv:WorkspaceColorToBrushConverter.Instance}}" />
                <TextBox Width="96" FontFamily="Consolas" VerticalContentAlignment="Center"
                         Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{DynamicResource WsProps_ColorHex}"
                         ToolTip="{DynamicResource WsProps_ColorHex}" />
            </StackPanel>
            <TextBlock Text="{Binding ColorError}" Style="{StaticResource ErrorText}" />
            <TextBlock Text="{DynamicResource WsProps_ColorHint}" Style="{StaticResource HintText}" />
        </StackPanel>

        <!-- Group -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource WsProps_Group}" Style="{StaticResource FieldLabel}" />
        <StackPanel Grid.Row="6" Grid.Column="1">
            <ComboBox IsEditable="True"
                      ItemsSource="{Binding Groups}"
                      Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{DynamicResource WsProps_Group}" />
            <TextBlock Text="{loc:Live WsProps_GroupHint}" Style="{StaticResource HintText}" />
        </StackPanel>

        <!-- Pinned -->
        <StackPanel Grid.Row="8" Grid.Column="1">
            <CheckBox Content="{DynamicResource WsProps_Pinned}" IsChecked="{Binding Pinned}" />
            <TextBlock Text="{loc:Live WsProps_PinnedHint}" Style="{StaticResource HintText}" Margin="20,4,0,0" />
        </StackPanel>

        <!-- Preview: the row as the sidebar and the menu will show it -->
        <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource WsProps_Preview}" Style="{StaticResource FieldLabel}" Margin="0,3,12,0" />
        <Border Grid.Row="10" Grid.Column="1"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="3"
                        Background="{Binding NormalizedColor, Converter={x:Static conv:WorkspaceColorToBrushConverter.Instance}}" />
                <StackPanel Orientation="Horizontal" Margin="8,5">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{Binding NormalizedColor, Converter={x:Static conv:WorkspaceColorToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding PreviewName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Group}" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundDimBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding ConfirmText}" MinWidth="90" Margin="0,0,8,0"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True" />
            <Button Content="{DynamicResource Cancel}" Width="90"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</local:TcvDialog>
