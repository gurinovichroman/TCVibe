<UserControl x:Class="TCV.App.Views.Panels.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:TCV.App.Controls"
             xmlns:conv="clr-namespace:TCV.App.Converters"
             xmlns:loc="clr-namespace:TCV.App.Localization"
             xmlns:settings="clr-namespace:TCV.App.Settings"
             xmlns:vm="clr-namespace:TCV.App.ViewModels">

    <!-- One panel, as the design draws it (docs/DESIGN.md, «Панель»): drives, tabs, path, the list and
         its status line. The active panel is the work surface, the other one steps back onto the
         quieter plane; which one has the keyboard is told by the tab's underline in the panel's tone,
         the cursor's hairline and the dot in the status line. The panels meet at 1px of border. -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BackgroundAltBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- DriveBar -->
                <RowDefinition Height="Auto" />  <!-- Tabs -->
                <RowDefinition Height="Auto" />  <!-- Path -->
                <RowDefinition Height="Auto" />  <!-- Filter -->
                <RowDefinition Height="*"    />  <!-- FileList -->
                <RowDefinition Height="Auto" />  <!-- StatusBar -->
            </Grid.RowDefinitions>

            <!-- Drive bar. Each strip of chrome can be hidden in Settings → Interface (6.33). -->
            <ctrl:DriveBar Grid.Row="0" Visibility="{DynamicResource ChromeDriveBarVisibility}" />

            <!-- Tab bar. Tabs that do not fit scroll (mouse wheel) instead of being cut off, the
                 active one is kept in view, and the ▾ button lists them all (6.52). -->
            <Border Grid.Row="1" Height="37" Padding="9,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{DynamicResource ChromeTabBarVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="TabScroller"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  PreviewMouseWheel="OnTabStripMouseWheel"
                                  ScrollChanged="OnTabStripScrollChanged"
                                  SizeChanged="OnTabStripSizeChanged">
                        <ItemsControl x:Name="TabBar"
                                      ItemsSource="{Binding Tabs}"
                                      AllowDrop="True"
                                      Drop="OnTabBarDrop"
                                      PreviewMouseMove="OnTabBarPreviewMouseMove">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                    <Border BorderThickness="0,0,0,2"
                                            Margin="0,0,4,0"
                                            Padding="10,0" Cursor="Hand"
                                            ToolTip="{Binding ToolTip}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            PreviewMouseLeftButtonDown="OnTabMouseDown"
                                            MouseUp="OnTabMouseUp"
                                            AutomationProperties.Name="{Binding DisplayTitle}"
                                            AllowDrop="True"
                                            Drop="OnTabDrop">
                                        <!-- The active tab is underlined: in the panel's tone while this panel has the
                                             keyboard, in dim text while it does not. -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ForegroundDimBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{Binding DataContext.BorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource Tab_Close}"
                                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{DynamicResource Tab_CloseOthers}"
                                                          Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Tab_Duplicate}"
                                                          Command="{Binding PlacementTarget.Tag.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Tab_Lock}"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding IsLocked, Mode=OneWay}"
                                                          Command="{Binding PlacementTarget.Tag.ToggleLockTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Tab_Rename}"
                                                          Command="{Binding PlacementTarget.Tag.StartRenameTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel x:Name="TabContent" Orientation="Horizontal" VerticalAlignment="Center"
                                                    TextElement.Foreground="{DynamicResource ForegroundDimBrush}">
                                            <!-- The connection's colour tag: production in red is told apart at a glance -->
                                            <Border Width="3" Height="12" CornerRadius="1.5" Margin="0,0,6,0"
                                                    Background="{Binding ConnectionColor}"
                                                    Visibility="{Binding ConnectionColor, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                            <!-- The folder of the tab the panel shows; a server, cloud, archive or search
                                                 tab keeps its icon while another tab is on screen (ADR-0032). -->
                                            <ctrl:Icon x:Name="TabIcon" Data="{StaticResource IconFolder}" Width="13" Height="13"
                                                       Margin="0,0,7,0" Visibility="Collapsed" />
                                            <!-- Tab title (normal display). A long folder name is shortened, not allowed to
                                                 push the other tabs out; the whole path is the tab's tooltip. -->
                                            <TextBlock x:Name="TabTitle" Text="{Binding DisplayTitle}"
                                                       FontSize="11"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <!-- Branch of this tab's directory: with several worktrees of one repository
                                                 open, the folder names look alike and this is what tells the tabs apart. -->
                                            <TextBlock x:Name="TabBranch" Text="{Binding Annotation}"
                                                       ToolTip="{Binding AnnotationToolTip}"
                                                       Margin="7,0,0,0"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="9"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="110"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="Collapsed" />
                                            <!-- Rename TextBox (shown during rename) -->
                                            <TextBox x:Name="RenameBox"
                                                     Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" MinWidth="60" MaxWidth="200"
                                                     Padding="2,0" BorderThickness="1"
                                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                                     BorderBrush="{DynamicResource AccentBrush}"
                                                     Visibility="Collapsed"
                                                     IsVisibleChanged="OnRenameBoxVisibleChanged"
                                                     LostFocus="OnRenameBoxLostFocus"
                                                     KeyDown="OnRenameBoxKeyDown"
                                                     PreviewMouseDown="OnRenameBoxPreviewMouseDown" />
                                            <!-- Locked: a padlock where the close button would be -->
                                            <ctrl:Icon x:Name="LockIcon" Data="{StaticResource IconLockKeyhole}" Width="11" Height="11"
                                                       Margin="7,0,0,0" Visibility="Collapsed" />
                                            <!-- Close button -->
                                            <Button x:Name="CloseButton"
                                                    ToolTip="{loc:Live Tab_CloseTip}"
                                                    AutomationProperties.Name="{DynamicResource Tab_Close}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="2" Margin="5,0,0,0"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.CloseTabCommand}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnCloseTabButtonClick">
                                                <ctrl:Icon Data="{StaticResource IconX}" Width="11" Height="11" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabContent" Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            <Setter TargetName="TabIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasAnnotation}" Value="True">
                                            <Setter TargetName="TabBranch" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMounted}" Value="True">
                                            <Setter TargetName="TabIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IconKind}" Value="server">
                                            <Setter TargetName="TabIcon" Property="Data" Value="{StaticResource IconServer}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IconKind}" Value="cloud">
                                            <Setter TargetName="TabIcon" Property="Data" Value="{StaticResource IconCloud}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IconKind}" Value="archive">
                                            <Setter TargetName="TabIcon" Property="Data" Value="{StaticResource IconArchive}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IconKind}" Value="search">
                                            <Setter TargetName="TabIcon" Property="Data" Value="{StaticResource IconSearch}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="TabBranch" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button x:Name="TabOverflowButton"
                            Style="{StaticResource ToolButton}"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Width="22"
                            ToolTip="{loc:Live Tab_AllTabsTip}"
                            AutomationProperties.Name="{DynamicResource Tab_AllTabs}"
                            Click="OnTabOverflowClick">
                        <ctrl:Icon Data="{StaticResource IconChevronDown}" Width="14" Height="14" />
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource ToolButton}"
                            Command="{Binding NewTabCommand}"
                            ToolTip="{loc:Live Panel_NewTabTip}"
                            AutomationProperties.Name="{DynamicResource Panel_NewTab}">
                        <ctrl:Icon Data="{StaticResource IconPlus}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Path bar: back, forward, up, the path, the filter. -->
            <Border Grid.Row="2" Height="38" Padding="9,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{DynamicResource ChromePathBarVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PathToolButton}" Margin="0,0,5,0"
                                Command="{Binding NavigateBackCommand}"
                                ToolTip="{loc:Live Nav_BackTip}" AutomationProperties.Name="{DynamicResource Nav_Back}">
                            <ctrl:Icon Data="{StaticResource IconArrowLeft}" />
                        </Button>
                        <Button Style="{StaticResource PathToolButton}" Margin="0,0,5,0"
                                Command="{Binding NavigateForwardCommand}"
                                ToolTip="{loc:Live Nav_ForwardTip}" AutomationProperties.Name="{DynamicResource Nav_Forward}">
                            <ctrl:Icon Data="{StaticResource IconArrowRight}" />
                        </Button>
                        <Button Style="{StaticResource PathToolButton}" Margin="0,0,5,0"
                                Command="{Binding FileList.NavigateUpCommand}"
                                ToolTip="{loc:Live Nav_UpTip}" AutomationProperties.Name="{DynamicResource Nav_Up}">
                            <ctrl:Icon Data="{StaticResource IconArrowUp}" />
                        </Button>
                        <!-- Where the mounted listing comes from: a server or a cloud, an archive -->
                        <ctrl:Icon Width="12" Height="12" Margin="0,0,5,0"
                                   Visibility="{Binding FileList.IsRemote, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <ctrl:Icon.Style>
                                <Style TargetType="ctrl:Icon">
                                    <Setter Property="Data" Value="{StaticResource IconServer}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChipKind}" Value="cloud">
                                            <Setter Property="Data" Value="{StaticResource IconCloud}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChipState}" Value="Failed">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChipState}" Value="Reconnecting">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctrl:Icon.Style>
                        </ctrl:Icon>
                        <ctrl:Icon Data="{StaticResource IconArchive}" Width="12" Height="12" Margin="0,0,5,0"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   Visibility="{Binding FileList.IsInsideArchive, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>
                    <ctrl:BreadcrumbBar Grid.Column="1" DataContext="{Binding FileList}" />
                    <ToggleButton Grid.Column="2" Style="{StaticResource PathToolToggle}"
                                  IsChecked="{Binding FileList.IsFilterOpen}"
                                  IsEnabled="{Binding FileList.CanQuickFilter}"
                                  ToolTip="{loc:Live Panel_FilterTip}"
                                  AutomationProperties.Name="{DynamicResource Panel_Filter}">
                        <ctrl:Icon Data="{StaticResource IconSearch}" />
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- The name filter (the quick search): opened by its button, by Ctrl+S or by typing a name into
                 the list, and the keys go into it either way. Text that matches no name is drawn in red: in
                 the jump mode (Settings → Files) the list stays whole, and nothing else would tell. -->
            <Border Grid.Row="3" Padding="9,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding FileList.IsFilterOpen, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Grid>
                    <ctrl:QuickFilterBox x:Name="FilterBox"
                                         DataContext="{Binding FileList}"
                                         Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{DynamicResource Panel_Filter}"
                                         FontSize="11"
                                         IsVisibleChanged="OnFilterBoxVisibleChanged"
                                         PreviewKeyDown="OnFilterBoxKeyDown">
                        <ctrl:QuickFilterBox.Style>
                            <Style TargetType="ctrl:QuickFilterBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuickSearchHasMatch}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:QuickFilterBox.Style>
                    </ctrl:QuickFilterBox>
                    <TextBlock Text="{DynamicResource Panel_FilterPlaceholder}"
                               Margin="8,0" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False"
                               Foreground="{DynamicResource ForegroundDimBrush}"
                               Visibility="{Binding FileList.QuickSearchText, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=inverse}" />
                </Grid>
            </Border>

            <!-- File list -->
            <ctrl:FileListControl x:Name="FileListView" Grid.Row="4"
                                  DataContext="{Binding FileList}"
                                  MouseDoubleClick="OnFileListDoubleClick"
                                  QuickFilterTyped="OnQuickFilterTyped" />

            <!-- Status line: which panel has the keyboard, what is listed, how it is listed. -->
            <Border Grid.Row="5" Height="29" Padding="11,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{DynamicResource ChromeStatusBarVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Which panel has the focus, in its tone (the tab's underline says it too) -->
                        <Ellipse Width="5" Height="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{Binding BorderBrush}"
                                 Visibility="{Binding IsActive, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding StatusBar.SelectedInfo}"
                                   ToolTip="{Binding StatusBar.FreeSpaceInfo}"
                                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- How the list shows its files. Hidden files, extensions and folders-first are a
                         right-click on these buttons in every view (Brief and Thumbnails have no column
                         header to carry that menu), the details header's menu, and the Settings menu. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{DynamicResource ChromeViewToolbarVisibility}">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Files_ShowHidden}" IsCheckable="True"
                                          IsChecked="{Binding FileList.ShowHiddenFiles}" />
                                <MenuItem Header="{DynamicResource Files_ShowExtensions}" IsCheckable="True"
                                          IsChecked="{Binding FileList.ShowExtensions}" />
                                <MenuItem Header="{DynamicResource Files_FoldersFirst}" IsCheckable="True"
                                          IsChecked="{Binding FileList.FoldersFirst}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <ToggleButton Style="{StaticResource ToolToggle}" Tag="{x:Static settings:ViewMode.Details}"
                                      IsChecked="{Binding FileList.ViewMode, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Details}"
                                      ToolTip="{DynamicResource Files_ViewDetails}"
                                      AutomationProperties.Name="{DynamicResource Files_ViewDetails}"
                                      Click="OnViewModeClick">
                            <ctrl:Icon Data="{StaticResource IconList}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolToggle}" Tag="{x:Static settings:ViewMode.Brief}"
                                      IsChecked="{Binding FileList.ViewMode, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Brief}"
                                      ToolTip="{DynamicResource Files_ViewBrief}"
                                      AutomationProperties.Name="{DynamicResource Files_ViewBrief}"
                                      Click="OnViewModeClick">
                            <ctrl:Icon Data="{StaticResource IconColumns3}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolToggle}" Tag="{x:Static settings:ViewMode.Thumbnails}"
                                      IsChecked="{Binding FileList.ViewMode, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Thumbnails}"
                                      ToolTip="{DynamicResource Files_ViewThumbs}"
                                      AutomationProperties.Name="{DynamicResource Files_ViewThumbs}"
                                      Click="OnViewModeClick">
                            <ctrl:Icon Data="{StaticResource IconLayoutGrid}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolToggle}" Tag="{x:Static settings:ViewMode.Tree}"
                                      IsChecked="{Binding FileList.ViewMode, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Tree}"
                                      ToolTip="{DynamicResource Files_ViewTree}"
                                      AutomationProperties.Name="{DynamicResource Files_ViewTree}"
                                      Click="OnViewModeClick">
                            <ctrl:Icon Data="{StaticResource IconListTree}" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
