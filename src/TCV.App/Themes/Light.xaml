<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette: the same keys as Dark.xaml (see there). Text-bearing tokens (dim text, accent,
         danger, warning, folder) are darker than the design's raw light values, which fall to 2.5â€“4.3:1
         on the light surfaces; here each reaches 4.5:1 so the 10â€“11px text stays readable. -->

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• Surfaces â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <Color x:Key="BackgroundColor">#FFF8F8FA</Color>
    <Color x:Key="BackgroundAltColor">#FFF0F2F4</Color>
    <Color x:Key="CardColor">#FFEFF0F2</Color>
    <Color x:Key="SurfaceColor">#FFE3E5E8</Color>
    <Color x:Key="BorderColor">#FFCED1D6</Color>
    <Color x:Key="ForegroundColor">#FF282B30</Color>
    <Color x:Key="ForegroundDimColor">#FF5E646C</Color>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• Accent and states â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <Color x:Key="AccentColor">#FF177225</Color>
    <Color x:Key="AccentHoverColor">#FF1F8A30</Color>
    <Color x:Key="SelectionColor">#FFCAE7CF</Color>
    <Color x:Key="SelectionHoverColor">#FFD7DBE1</Color>
    <Color x:Key="DirectoryColor">#FF875A01</Color>
    <Color x:Key="DangerColor">#FFB83334</Color>
    <Color x:Key="SuccessColor">#FF02773E</Color>
    <Color x:Key="WarningColor">#FF875A01</Color>
    <Color x:Key="InfoColor">#FF036EAE</Color>

    <SolidColorBrush x:Key="BackgroundBrush"       Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundAltBrush"    Color="{StaticResource BackgroundAltColor}" />
    <SolidColorBrush x:Key="CardBrush"              Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ForegroundBrush"       Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="ForegroundDimBrush"    Color="{StaticResource ForegroundDimColor}" />
    <!-- Replaced by the user's accent: read these with DynamicResource (see Dark.xaml). -->
    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="SelectionBrush"        Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="SelectionHoverBrush"   Color="{StaticResource SelectionHoverColor}" />
    <SolidColorBrush x:Key="DirectoryBrush"        Color="{StaticResource DirectoryColor}" />
    <SolidColorBrush x:Key="DangerBrush"           Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="SuccessBrush"          Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush"          Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="InfoBrush"             Color="{StaticResource InfoColor}" />
    <!-- Source-code files in the list (the design's code teal) -->
    <SolidColorBrush x:Key="CodeBrush"             Color="#FF047576" />
    <!-- Pictures, video and sound in the list (the syntax palette's pink) -->
    <SolidColorBrush x:Key="MediaBrush"            Color="#FFA44393" />

    <SolidColorBrush x:Key="HoverBrush"            Color="#0F000000" />
    <SolidColorBrush x:Key="PressedBrush"          Color="#1F000000" />
    <SolidColorBrush x:Key="RowLineBrush"          Color="#47CED1D6" />
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#665E646C" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B35E646C" />

    <SolidColorBrush x:Key="DangerSoftBrush"       Color="#FFFEDBD7" />
    <SolidColorBrush x:Key="HighlightBrush"        Color="#FF8A5A00" />

    <!-- â•â•â•â•â•â•â• Syntax highlighting (F3 code preview, 6.18) â•â•â•â•â•â•â• -->
    <!-- The same hue tokens as the dark theme, darkened for a light code background. -->
    <SolidColorBrush x:Key="SyntaxKeywordBrush"  Color="#FF036EAE" />
    <SolidColorBrush x:Key="SyntaxTypeBrush"     Color="#FF047576" />
    <SolidColorBrush x:Key="SyntaxStringBrush"   Color="#FF875A01" />
    <SolidColorBrush x:Key="SyntaxNumberBrush"   Color="#FF02773E" />
    <SolidColorBrush x:Key="SyntaxCommentBrush"  Color="#FF5E646C" />
    <SolidColorBrush x:Key="SyntaxMetaBrush"     Color="#FFA44393" />
    <SolidColorBrush x:Key="SyntaxAddedBrush"    Color="#FF02773E" />
    <SolidColorBrush x:Key="SyntaxRemovedBrush"  Color="#FFB83334" />
    <SolidColorBrush x:Key="SyntaxHunkBrush"     Color="#FF036EAE" />
    <SolidColorBrush x:Key="SyntaxGutterBrush"   Color="#FF5E646C" />
    <SolidColorBrush x:Key="SyntaxCodeBackBrush" Color="#FFF8F8FA" />

</ResourceDictionary>
