<UserControl x:Class="TCV.App.Controls.DriveBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:TCV.App.Controls"
             xmlns:conv="clr-namespace:TCV.App.Converters"
             xmlns:loc="clr-namespace:TCV.App.Localization">

    <!-- The drive strip (design: .drive-bar, 34px): a button per drive — the panel's own one on the quiet
         slab — then the server and archive sources; on the right, how much room the panel's volume has
         and Refresh. A drive that came or went shows up by itself (DriveManager); hovering the strip
         reads the list again. -->
    <Border Height="34" Padding="10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            MouseEnter="OnMouseEnterStrip">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The volume's room, as Total Commander and Double Commander show it beside the drive:
                     «182 GB free of 512 GB» with a bar of how full it is under it, red under a tenth left. The
                     name, the file system and the exact bytes are in the tooltip. Measured after every
                     listing (StatusBarViewModel), so a copy or a delete shows up on the next reload. -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent"
                            Visibility="{Binding StatusBar.HasFreeSpace, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                            AutomationProperties.Name="{Binding StatusBar.FreeSpaceText}">
                    <StackPanel.ToolTip>
                        <StackPanel>
                            <TextBlock FontWeight="Medium"
                                       Visibility="{Binding DriveBar.SelectedDrive, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <Run Text="{Binding DriveBar.SelectedDrive.DisplayName, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding DriveBar.SelectedDrive.DriveFormat, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding StatusBar.FreeSpaceInfo}" />
                        </StackPanel>
                    </StackPanel.ToolTip>
                    <TextBlock Text="{Binding StatusBar.FreeSpaceText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="180">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusBar.IsLowSpace}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Height="3" Maximum="1" Margin="0,3,0,0" HorizontalAlignment="Stretch"
                                 Value="{Binding StatusBar.UsedFraction, Mode=OneWay}" IsHitTestVisible="False"
                                 Background="{DynamicResource BorderBrush}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusBar.IsLowSpace}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <Button Style="{StaticResource ToolButton}" Tag="RefreshTab" Click="OnRunCommand"
                        ToolTip="{loc:Live Drive_RefreshTip}" AutomationProperties.Name="{DynamicResource Drive_Refresh}">
                    <ctrl:Icon Data="{StaticResource IconRefreshCw}" />
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- One button per drive; choosing one navigates (DriveBarViewModel.SelectedDrive). -->
                <ListBox ItemsSource="{Binding DriveBar.Drives}"
                         SelectedItem="{Binding DriveBar.SelectedDrive}"
                         AutomationProperties.Name="{DynamicResource Drive_Name}"
                         Background="Transparent" BorderThickness="0" Padding="0" PreviewMouseLeftButtonDown="OnDriveMouseDown"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="23" Margin="0,0,3,0">
                                            <!-- In the template, not a style setter: a setter's element would be one tooltip shared by every button. -->
                                            <Grid.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" />
                                                    <TextBlock Text="{Binding SpaceText}"
                                                               Visibility="{Binding SpaceText, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                                </StackPanel>
                                            </Grid.ToolTip>
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" />
                                            <Border x:Name="Tint" Opacity="0" Background="{DynamicResource HoverBrush}" CornerRadius="3" />
                                            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                <ctrl:Icon x:Name="DriveIcon" Data="{StaticResource IconHardDrive}" Width="12" Height="12" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding Letter}" FontSize="10" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                <Setter TargetName="DriveIcon" Property="Data" Value="{StaticResource IconNetwork}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tint" Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- A UNC share, or a drive that is not ready, has no button: its root is shown as the
                     current place instead of the drive the panel left (6.52). -->
                <ToggleButton Style="{StaticResource DriveToggle}" IsChecked="True" IsHitTestVisible="False"
                              Visibility="{Binding DriveBar.LocationText, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:Icon Data="{StaticResource IconNetwork}" Width="12" Height="12" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding DriveBar.LocationText}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ToggleButton>

                <!-- The connection chip (ADR-0032). On the disk it is the "Connections" drop-down of this panel:
                     the saved servers, storages and drives, Quick connect, the manager. On a connection it names
                     it — colour tag, state dot, name — with Disconnect beside it; the drop-down then starts with
                     Disconnect, Reconnect, Edit and Copy address. The toolbar's Connections opens the manager. -->
                <Border x:Name="ConnectionChip" CornerRadius="3" Margin="0,0,3,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnection}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConnectionButton" Style="{StaticResource DriveButton}" Margin="0"
                                Click="OnConnectionButtonClick"
                                ToolTip="{Binding ChipToolTip}"
                                AutomationProperties.Name="{Binding ChipTitle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- The connection's colour tag: production in red is told apart at a glance -->
                                <Border Width="3" Height="12" CornerRadius="1.5" Margin="0,0,5,0" Background="{Binding ChipColor}"
                                        Visibility="{Binding ChipColor, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                <ctrl:Icon Width="12" Height="12" Margin="0,0,5,0">
                                    <ctrl:Icon.Style>
                                        <Style TargetType="ctrl:Icon">
                                            <Setter Property="Data" Value="{StaticResource IconServer}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChipKind}" Value="cloud">
                                                    <Setter Property="Data" Value="{StaticResource IconCloud}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChipKind}" Value="share">
                                                    <Setter Property="Data" Value="{StaticResource IconNetwork}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ctrl:Icon.Style>
                                </ctrl:Icon>
                                <!-- State: green answering, amber on its way or reconnecting by itself, red stopped answering -->
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChipState}" Value="None">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChipState}" Value="Online">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChipState}" Value="Failed">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ChipTitle}" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <ctrl:Icon Data="{StaticResource IconChevronDown}" Width="10" Height="10" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <!-- Disconnect, while on a connection; Cancel, while one is being opened -->
                        <Button Style="{StaticResource DriveButton}" Margin="0" Padding="5,0" Tag="Disconnect" Click="OnRunCommand"
                                ToolTip="{loc:Live Chip_DisconnectTip}" AutomationProperties.Name="{DynamicResource Chip_Disconnect}"
                                Visibility="{Binding HasConnection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <ctrl:Icon Data="{StaticResource IconUnplug}" Width="12" Height="12" />
                        </Button>
                        <Button Style="{StaticResource DriveButton}" Margin="0" Padding="5,0" Click="OnCancelConnectClick"
                                ToolTip="{DynamicResource Chip_CancelTip}" AutomationProperties.Name="{DynamicResource Chip_Cancel}"
                                Visibility="{Binding IsConnecting, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <ctrl:Icon Data="{StaticResource IconX}" Width="12" Height="12" />
                        </Button>
                        <!-- Stop, while a dropped connection is being opened again by itself (6.82) -->
                        <Button Style="{StaticResource DriveButton}" Margin="0" Padding="5,0" Click="OnStopReconnectClick"
                                ToolTip="{DynamicResource Conn_ReconnectStop}" AutomationProperties.Name="{DynamicResource Conn_ReconnectStop}"
                                Visibility="{Binding IsReconnecting, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <ctrl:Icon Data="{StaticResource IconX}" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- The archive the panel is inside, if any -->
                <ToggleButton Style="{StaticResource DriveToggle}" IsChecked="True" IsHitTestVisible="False"
                              ToolTip="{Binding FileList.MountRootLabel}"
                              AutomationProperties.Name="{DynamicResource Drive_Archive}"
                              Visibility="{Binding FileList.IsInsideArchive, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <ctrl:Icon Data="{StaticResource IconArchive}" Width="12" Height="12" />
                </ToggleButton>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
